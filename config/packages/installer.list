# installer.list — the Calamares installer and everything it needs on the
# live ISO. Calamares on Ubuntu is Qt 6; its package dependencies (kpmcore,
# Qt libraries, ...) are pulled automatically. Settings and branding are the
# ones in config/calamares/, installed by scripts/50-installer.sh.

calamares

# Tools the Calamares modules run (installed with --no-install-recommends, so
# they are NOT pulled in as recommendations of calamares):
#   unpackfs   -> unsquashfs (squashfs-tools) + rsync (already in base.list)
#   partition  -> parted, dosfstools (mkfs.fat for the EFI system partition)
#   bootloader -> efibootmgr (UEFI entry), grub-pc-bin (BIOS grub-install)
# Missing squashfs-tools gave "Bad unpackfs configuration: Failed to find
# unsquashfs" at the end of an installation.
squashfs-tools
parted
dosfstools
efibootmgr
grub-pc-bin
