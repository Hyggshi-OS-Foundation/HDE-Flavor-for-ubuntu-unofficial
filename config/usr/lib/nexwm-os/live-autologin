#!/bin/bash
# live-autologin — write the SDDM automatic-login configuration for the boot's
# casper user. Runs only on the live medium. The username is read back from
# the casper configuration rather than baked in, so kernel-level overrides
# (username=...) still work.

set -eu
CONF_DIR=/etc/sddm.conf.d
[ -d "$CONF_DIR" ] || CONF_DIR=/usr/lib/sddm/sddm.conf.d

LIVE_USER=""
for source in /etc/casper.conf /run/casper.conf; do
    if [ -f "$source" ] && grep -q '^USERNAME=' "$source"; then
        LIVE_USER="$(sed -n 's/^USERNAME="\?\([^"]*\)"\?$/\1/p' "$source" | head -n 1)"
        [ -n "$LIVE_USER" ] && break
    fi
done
[ -n "$LIVE_USER" ] || LIVE_USER="$(getent passwd '1000' | cut -d: -f1)"
[ -n "$LIVE_USER" ] || LIVE_USER="ubuntu"

DEFAULT_SESSION="$(sed -n 's/^DEFAULT_SESSION="\?\([^"]*\)"\?$/\1/p' /etc/os-release 2>/dev/null || true)"
[ -n "$DEFAULT_SESSION" ] || DEFAULT_SESSION="$(awk -F= '/^DEFAULT_SESSION=/{print $2}' /etc/os-release 2>/dev/null || true)"
[ -n "$DEFAULT_SESSION" ] || DEFAULT_SESSION="nexwm"

mkdir -p "$CONF_DIR"
cat > "$CONF_DIR/99-nexwm-os-live-autologin.conf" <<EOF
# Written per boot by /usr/lib/nexwm-os/live-autologin (nexwm-os-live-autologin
# service). Exists only on the live medium.
[Autologin]
User=$LIVE_USER
Session=$DEFAULT_SESSION
Relogin=false
EOF
echo "live-autologin: SDDM will log in '$LIVE_USER' with session '$DEFAULT_SESSION'"
